# Seafile MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: Your Seafile server URL
SEAFILE_SERVER_URL=https://your-seafile-server.com

# ============================================
# Authentication (choose ONE method)
# ============================================

# Option 1: Account authentication (access all your libraries)
SEAFILE_USERNAME=your@email.com
SEAFILE_PASSWORD=your-password

# Option 2: Repo token authentication (single library, more secure)
# Generate this in Seafile Web UI: Library -> Advanced -> API Token
# SEAFILE_REPO_TOKEN=your-repo-api-token
# SEAFILE_REPO_ID=library-uuid-here

# ============================================
# Optional Settings
# ============================================

# Maximum file size to read into memory (bytes, default: 1MB)
# SEAFILE_MAX_READ_SIZE=1048576

# Maximum file size for uploads (bytes, default: 10MB)
# SEAFILE_MAX_WRITE_SIZE=10485760

# Request timeout in seconds (default: 30)
# SEAFILE_TIMEOUT=30

# ============================================
# HTTP server (needed for Claude custom connectors)
# ============================================

# streamable-http (default), sse, or stdio for local clients (Claude Desktop, OpenCode)
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000   # docker-compose publishes this port on 127.0.0.1
# MCP_PATH=/mcp

# OAuth sign-in: on when MCP_AUTH_PASSWORD is set. Leave both unset only for
# local testing; without a password anyone who reaches the port can use Seafile.
# Public HTTPS URL of this server, without the /mcp path:
MCP_PUBLIC_URL=https://mcp.example.com
# Password asked on the sign-in page when you connect Claude (min 12 chars).
# Generate one with: openssl rand -base64 24
MCP_AUTH_PASSWORD=change-me-to-a-long-password
# Where to keep registered clients and tokens (in memory only if unset):
# MCP_OAUTH_STATE_FILE=/data/oauth.json
# Token lifetimes in seconds (defaults: 1 hour / 30 days):
# MCP_ACCESS_TOKEN_TTL=3600
# MCP_REFRESH_TOKEN_TTL=2592000
